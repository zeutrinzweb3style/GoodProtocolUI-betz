# GoodProtocolUI — environment template
#
# These values are read at BUILD time. On Vercel set them in
# Project -> Settings -> Environment Variables (see docs/VERCEL_ENV.md), because
# vite.config.ts inlines the real process.env and .env files are filtered by the
# default VITE_ prefix.
#
# Local development:
#   cp .env.example .env
#   set -a; source .env; set +a
#   yarn dev

# -- Required ---------------------------------------------------------------
# production-celo | staging-celo | development-celo | fuse
REACT_APP_NETWORK=production-celo
# WalletConnect / AppKit project id - create one free at https://cloud.reown.com
REOWN_PROJECT_ID=

# -- RPC endpoints (comma separated list = failover) ------------------------
REACT_APP_CELO_RPC=https://forno.celo.org
REACT_APP_FUSE_RPC=https://rpc.fuse.io
REACT_APP_XDC_RPC=https://rpc.xinfin.network
REACT_APP_MAINNET_RPC=
REACT_APP_RPC_FALLBACK_CHAIN_IDS=
REACT_APP_EXCLUDED_RPCS=

# -- App behaviour ----------------------------------------------------------
REACT_APP_ENABLE_SERVICE_WORKER=1
REACT_APP_ENABLE_HTTPS_REDIRECT=1
# Shows the Savings sections on Stake/Portfolio when set
REACT_APP_CELO_PHASE_3=
# JSON string of public UBI pool addresses
REACT_APP_UBIPOOL_ADDRESSES=
REACT_APP_GOODID_CELO_EXPLORER=
REACT_APP_GOODID_FUSE_EXPLORER=
REACT_APP_GOODID_XDC_EXPLORER=
REACT_APP_GOODID_MAINNET_EXPLORER=

# -- Data / analytics (all optional, blank = off) ---------------------------
REACT_APP_GRAPH_KEY=
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_PROXY=
REACT_APP_GOOGLE_ANALYTICS_ID=
REACT_APP_INDICATIVE_KEY=
REACT_APP_ONRAMPER_KEY=
REACT_APP_ETHERSCAN_KEY=
REACT_APP_DATASTUDIO_DASHBOARD_URL=
REACT_APP_FEEDCONTEXT_PROD=

# -- On-chain support chat (blank contract = widget hidden) -----------------
REACT_APP_SUPPORT_CHAT_CONTRACT=
REACT_APP_SUPPORT_CHAT_DEPLOY_BLOCK=
REACT_APP_SUPPORT_TG_URL=https://t.me/GoodDollarX

# -- Legacy CRA leftovers (harmless, kept for parity) -----------------------
DISABLE_ESLINT_PLUGIN=true
BROWSER=none
